# --- OpenRouter (server-only; never prefix with NEXT_PUBLIC_) ---
OPENROUTER_API_KEY=
# The guide's voice: needs nuance and restraint
OPENROUTER_GUIDE_MODEL=anthropic/claude-sonnet-5.5
# Tried only if the primary model fails
OPENROUTER_GUIDE_FALLBACK_MODEL=google/gemini-3.8-flash

# live = AI guide (still requires the key); demo = scripted questions only
APP_MODE=live
# Optional extra allowed origin (same-host requests are always allowed)
APP_ORIGIN=

# --- Accounts (server-only) ---
# Signs session cookies. 32+ random characters. Rotating it signs everyone out (accounts are kept).
AUTH_SECRET=
# Private Vercel Blob store for accounts + journals (added automatically by `vercel blob create-store`).
# Without it, local development stores everything in ./.data (gitignored).
BLOB_READ_WRITE_TOKEN=

# Limits
KOAN_RATE_PER_MINUTE=12
KOAN_GLOBAL_PER_HOUR=600
